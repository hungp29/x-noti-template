<div style="font-family:system-ui,sans-serif;font-size:15px;line-height:1.5;color:#1a1a1a;">
<p><strong>{{.ProductLinkName}}</strong></p>
<p><a href="{{.ProductLinkURL}}" style="color:#0066cc;word-break:break-all;">{{.ProductLinkURL}}</a></p>
<p>New price: <strong>{{.NewPrice}}</strong></p>
<p>Vs previous scan: {{.DeltaVsPrevious}}</p>
<p>Vs lowest on this link: {{.DeltaVsLinkLowest}}</p>
<p>{{.Cross}}</p>{{.PerUnitHTML}}</div>
